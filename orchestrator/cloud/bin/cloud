#!/usr/bin/env bash
# cloud: see and swap the active AWS profile and GCP configuration (cloud --help). Runs cli.ts with node (22.18+
# strips the types itself).
set -euo pipefail
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
exec node --disable-warning=ExperimentalWarning "$here/../cli.ts" "$@"
